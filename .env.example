# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# PostgreSQL
DATABASE_URL=postgres://ghost:ghost@localhost:5432/ghostenger

# Redis
REDIS_URL=redis://localhost:6379

# Application
APP_ENV=development

# JWT (generate a strong random string for production, e.g. `openssl rand -hex 32`)
JWT_SECRET=change_me_in_production
